# ==============================================================================
# Autonomous AI Software Engineer - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your environment variables:
#   copy .env.example .env     (Windows Command Prompt)
#   Copy-Item .env.example .env (Windows PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
APP_NAME="Autonomous AI Software Engineer"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="change-this-to-a-secure-random-secret-key-at-least-32-chars"

# ------------------------------------------------------------------------------
# 2. Server & API Settings
# ------------------------------------------------------------------------------
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ------------------------------------------------------------------------------
# 3. Database Settings (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Local docker-compose maps external 5433 -> internal 5432 to prevent conflict with local Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ai_engineer
POSTGRES_USER=ai_engineer
POSTGRES_PASSWORD=changeme

# (Optional) Direct database connection string (overrides the fields above if provided):
# DATABASE_URL=postgresql+asyncpg://ai_engineer:changeme@localhost:5433/ai_engineer

# ------------------------------------------------------------------------------
# 4. LLM / AI Model Settings
# ------------------------------------------------------------------------------
# Provider: "openai", "openai_compatible", or "local" (e.g., Ollama / vLLM)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# OpenAI API Key (Required for code generation, architectural planning, and audits)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Base URL if using Ollama, vLLM, Azure, or private proxy:
# LLM_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 5. Embeddings Settings (pgvector RAG for codebase indexing)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ------------------------------------------------------------------------------
# 6. GitHub Integration Settings
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) with repository read/write permissions
GITHUB_TOKEN=your-github-token-here

# ------------------------------------------------------------------------------
# 7. Agent & Sandbox Execution Configuration
# ------------------------------------------------------------------------------
MAX_RETRIES=3
MAX_AGENT_ITERATIONS=50
MAX_TOOL_CALLS=200
MAX_REPO_SIZE_MB=500
MAX_FILE_SIZE_KB=512

SANDBOX_CPU_QUOTA=50000
SANDBOX_MEMORY_MB=512
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_NETWORK_DISABLED=true

# Directory for storing cloned repositories and sandboxed workspace runs
WORKSPACE_BASE_DIR=./workspaces

# ------------------------------------------------------------------------------
# 8. Frontend Settings (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME="Autonomous AI Software Engineer"
